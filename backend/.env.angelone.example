# Copy these values into your local backend/.env (never commit the real values).
# SmartAPI host
ANGELONE_BASE_URL=https://apiconnect.angelone.in

# SmartAPI credentials
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=

# Registered primary static IPv4 for production order execution
ANGELONE_PRIMARY_STATIC_IP=

# Optional provider/client identifiers used by your Angel One setup
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_MAC_ADDRESS=
